<div
  class="relative-container"
  id="popup-overlay"
>
  <div class="form-container">
    <button
      class="close-btn"
      id="close-btn"
      aria-label="Close popup"
      tabindex="0"
    >
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <line
          x1="18"
          y1="6"
          x2="6"
          y2="18"
        ></line>
        <line
          x1="6"
          y1="6"
          x2="18"
          y2="18"
        ></line>
      </svg>
    </button>
    <form
      id="contact-form"
      class="form-box"
    >
      <div class="form-group">
        <label
          class="form-label"
          for="company"
        >
          Company
          <span
            class="tooltip-icon"
            tabindex="0"
            aria-label="Why do we ask this?"
          >
            ?
            <span
              class="tooltip-text"
              role="tooltip"
            >
              This helps us know how many visitors are real people, not bots.
            </span>
          </span>
        </label>
        <input
          id="company"
          type="text"
          name="company"
          class="form-input"
          placeholder="Your company name"
          required
        />
        <div
          class="error-message"
          id="company-error"
        >
        </div>
      </div>

      <div class="checkbox-group">
        <label
          class="checkbox-wrapper"
          id="checkbox-wrapper"
          for="isHuman"
        >
          <input
            id="isHuman"
            type="checkbox"
            name="isHuman"
            value="yes"
            class="checkbox-input"
            required
          />
          <div
            class="custom-checkbox"
            id="custom-checkbox"
          >
          </div>

          I confirm I am a real person (not a bot)
        </label>
        <div
          class="error-message"
          id="checkbox-error"
        >
        </div>
      </div>

      <button
        type="submit"
        class="submit-btn"
        >Submit</button
      >
    </form>
  </div>

  <script>
    class HumanVerification {
      constructor() {
        this.popup = document.getElementById("popup-overlay");
        this.form = document.getElementById("contact-form");
        this.thankYou = document.getElementById("thank-you");
        this.checkboxWrapper = document.getElementById("checkbox-wrapper");
        this.customCheckbox = document.getElementById("custom-checkbox");
        this.checkboxInput = document.getElementById("isHuman");
        this.submitBtn = this.form.querySelector(".submit-btn");
        this.closeBtn = document.getElementById("close-btn");

        this.init();
      }

      init() {
        // Check if already verified or closed
        const alreadyVerified = this.getStoredValue("isHuman");
        const popupClosed = this.getStoredValue("popupClosed");

        if (alreadyVerified === "yes" || popupClosed === "yes") {
          this.hidePopup();
          return;
        }

        this.setupEventListeners();
        this.showPopup();
      }

      setupEventListeners() {
        this.form.addEventListener("submit", this.handleSubmit.bind(this));
        this.checkboxInput.addEventListener("change", this.handleCheckboxChange.bind(this));

        // // Make checkbox clickable - add click event to wrapper and custom checkbox
        // this.checkboxWrapper.addEventListener("click", this.toggleCheckbox.bind(this));
        // this.customCheckbox.addEventListener("click", this.toggleCheckbox.bind(this));

        // Input validation
        const companyInput = document.getElementById("company");
        companyInput.addEventListener("blur", () => this.validateCompany());
        companyInput.addEventListener("input", () => this.clearError("company-error"));

        // Close functionality
        this.closeBtn.addEventListener("click", () => this.handleClosePopup());

        // Close on escape key
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && this.popup.classList.contains("visible")) {
            this.handleClosePopup();
          }
        });

        // Close on overlay click (but not on form click)
        this.popup.addEventListener("click", (e) => {
          if (e.target === this.popup) {
            this.handleClosePopup();
          }
        });
      }

      handleCheckboxChange() {
        console.log("checkbox clicked");
        if (this.checkboxInput.checked) {
          this.checkboxWrapper.classList.add("checked");
          this.clearError("checkbox-error");
        } else {
          this.checkboxWrapper.classList.remove("checked");
        }
      }

      async handleClosePopup() {
        // Store that popup was closed
        this.storeValue("popupClosed", "yes");

        // Send form data indicating popup was closed
        try {
          const formData = new FormData();
          formData.append("company", "N/A");
          formData.append("isHuman", "popup_closed");
          formData.append("action", "Popup closed by user");

          await fetch("https://formspree.io/f/xeogbgzo", {
            method: "POST",
            headers: { Accept: "application/json" },
            body: formData,
          });
        } catch (error) {
          console.log("Failed to send close event");
        }

        this.hidePopup();
      }

      validateCompany() {
        const companyInput = document.getElementById("company");
        const value = companyInput.value.trim();

        if (!value) {
          this.showError("company-error", "Company name is required");
          return false;
        }

        if (value.length < 2) {
          this.showError("company-error", "Company name must be at least 2 characters");
          return false;
        }

        return true;
      }

      validateCheckbox() {
        if (!this.checkboxInput.checked) {
          this.showError("checkbox-error", "Please confirm you are a real person");
          return false;
        }
        return true;
      }

      showError(errorId, message) {
        const errorElement = document.getElementById(errorId);
        errorElement.textContent = message;
        errorElement.style.display = "block";
      }

      clearError(errorId) {
        const errorElement = document.getElementById(errorId);
        errorElement.style.display = "none";
      }

      async handleSubmit(e) {
        e.preventDefault();

        // Validate all fields
        const isCompanyValid = this.validateCompany();
        const isCheckboxValid = this.validateCheckbox();

        if (!isCompanyValid || !isCheckboxValid) {
          return;
        }

        this.setLoading(true);

        try {
          const formData = new FormData(this.form);
          formData.append("action", "Form submitted");

          const response = await fetch("https://formspree.io/f/xeogbgzo", {
            method: "POST",
            headers: { Accept: "application/json" },
            body: formData,
          });

          if (response.ok) {
            this.storeValue("isHuman", "yes");
            this.hidePopup();
          } else {
            throw new Error("Submission failed");
          }
        } catch (error) {
          this.showError("company-error", "There was a problem submitting your form.");
        } finally {
          this.setLoading(false);
        }
      }

      setLoading(loading) {
        this.submitBtn.disabled = loading;
        this.submitBtn.textContent = loading ? "Submitting..." : "Submit";
      }

      showSuccess() {
        this.form.style.display = "none";
        this.thankYou.style.display = "block";
      }

      showPopup() {
        this.popup.classList.add("visible");
        document.body.style.overflow = "hidden"; // Prevent background scrolling
      }

      hidePopup() {
        this.popup.classList.remove("visible");
        document.body.style.overflow = ""; // Restore scrolling
      }

      storeValue(key, value) {
        // Using a simple in-memory storage for demo purposes
        // In a real implementation, you'd use localStorage or sessionStorage
        localStorage.setItem(`stored_${key}`, value);
      }

      getStoredValue(key) {
        return localStorage.getItem(`stored_${key}`) || null;
      }
    }

    document.addEventListener("DOMContentLoaded", () => {
      new HumanVerification();
    });
  </script>

  <style>
    .relative-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: 10000;
      display: flex;
      justify-content: center;
      align-items: center;
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.95) 100%);
      backdrop-filter: blur(12px);
      opacity: 0;
      visibility: hidden;
      transition: all 0.3s ease;
    }

    .relative-container.visible {
      opacity: 1;
      visibility: visible;
    }

    .close-btn {
      position: absolute;
      top: -15px;
      right: -15px;
      width: 36px;
      height: 36px;
      border: none;
      border-radius: 50%;
      background-color: var(--gray-800);
      color: var(--gray-200);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
      z-index: 1;
      backdrop-filter: blur(10px);
    }

    .close-btn:hover {
      background: rgba(239, 68, 68, 0.8);
      color: white;
      transform: scale(1.1);
    }

    .close-btn:focus {
      outline: 2px solid rgba(255, 255, 255, 0.5);
      outline-offset: 2px;
    }

    .form-container {
      display: flex;
      width: 100%;
      max-width: 500px;
      margin: 0 auto;
      transform: translateY(20px) scale(0.95);
      transition: transform 0.3s ease;
    }

    .relative-container.visible .form-container {
      transform: translateY(0) scale(1);
    }

    .form-box {
      border: 1px solid var(--gray-800);
      border-radius: 1rem;
      padding: 2rem;
      background-color: var(--gray-999);
      box-shadow: var(--shadow-sm);
      width: 100%;
      color: var(--gray-200);
      backdrop-filter: blur(10px);
    }

    .form-group {
      display: flex;
      flex-direction: column;
      margin-bottom: 1.5rem;
    }

    .form-label {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      margin-bottom: 0.75rem;
      font-weight: 600;
      font-size: var(--text-md);
    }

    .form-input {
      padding: 0.75rem;
      font-size: var(--text-md);
      border: 1px solid var(--gray-800);
      border-radius: 0.5rem;
      background-color: var(--gray-900);
      color: var(--gray-200);
      transition: var(--theme-transition);
    }

    .form-input:focus,
    .checkbox-input:focus + .custom-checkbox {
      outline: none;
      border-color: var(--accent-regular);
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    }

    .form-input::placeholder {
      color: #6b7280;
    }

    .checkbox-group {
      margin-bottom: 1.5rem;
      cursor: pointer;
    }

    .custom-checkbox {
      position: relative;
      width: 20px;
      height: 20px;
      border: 2px solid var(--gray-800);
      border-radius: 4px;
      background: transparent;
      transition: var(--theme-transition);
      flex-shrink: 0;
      margin-top: 2px;
    }

    .custom-checkbox::after {
      content: "";
      position: absolute;
      left: 50%;
      top: 50%;
      width: 4px;
      height: 8px;
      border: solid white;
      border-width: 0 2px 2px 0;
      transform: translate(-50%, -60%) rotate(45deg) scale(0);
      transition: transform 0.2s ease;
    }

    .checkbox-wrapper.checked .custom-checkbox {
      background: #10b981;
      border-color: #10b981;
    }

    .checkbox-wrapper.checked .custom-checkbox::after {
      transform: translate(-50%, -60%) rotate(45deg) scale(1);
    }

    .checkbox-input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .checkbox-wrapper {
      cursor: pointer;
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      color: var(--gray-200);
      font-size: var(--text-md);
      line-height: 1.5;
      user-select: none;
    }

    .tooltip-icon {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.25rem;
      height: 1.25rem;
      border-radius: 50%;
      background-color: var(--accent-regular);
      color: var(--accent-text-over);
      font-weight: bold;
      font-size: 1rem;
      cursor: help;
      user-select: none;
      transition: var(--theme-transition);
    }

    .tooltip-icon:hover {
      background-color: var(--accent-dark);
    }

    .tooltip-text {
      visibility: hidden;
      opacity: 0;
      width: 220px;
      background-color: #222;
      color: #eee;
      text-align: center;
      border-radius: 0.5rem;
      padding: 0.5rem 0.75rem;
      position: absolute;
      bottom: 125%;
      left: 50%;
      transform: translateX(-50%);
      transition: opacity 0.2s ease-in-out;
      font-size: 0.85rem;
      pointer-events: none;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
    }

    .tooltip-icon:focus .tooltip-text,
    .tooltip-icon:hover .tooltip-text {
      visibility: visible;
      opacity: 1;
    }

    .submit-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border-radius: 999rem;
      background-color: var(--accent-regular);
      color: var(--accent-text-over);
      font-size: var(--text-md);
      padding: 0.7rem 1.5rem;
      font-weight: 500;
      cursor: pointer;
      border: none;
      box-shadow: var(--shadow-md);
      transition: var(--theme-transition);
      min-width: 9rem;
      float: right;
    }

    .submit-btn:hover {
      background-color: var(--accent-dark);
    }

    .submit-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .success-message {
      max-width: 500px;
      margin: 0 auto;
      padding: 1rem;
      border: 1px solid #10b981;
      color: #a7f3d0;
      background-color: #064e3b;
      border-radius: 1rem;
      text-align: center;
      display: none;
    }

    .error-message {
      color: #fca5a5;
      background-color: rgba(239, 68, 68, 0.1);
      border: 1px solid #ef4444;
      padding: 0.5rem 0.75rem;
      border-radius: 0.5rem;
      margin-top: 0.5rem;
      font-size: 0.875rem;
      display: none;
    }

    @media (max-width: 640px) {
      .form-box {
        padding: 1.5rem;
      }

      .tooltip-text {
        width: 180px;
      }

      .close-btn {
        top: -15px;
        right: -15px;
        width: 32px;
        height: 32px;
      }
    }
  </style>
</div>
